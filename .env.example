# ---------------------------------------------------------------------------
# Alpaca — PAPER (sandbox) credentials only.
# Generate at https://app.alpaca.markets/paper/dashboard/overview -> "API Keys".
# broker.py hardcodes paper=True; live keys will simply fail to authenticate
# against the sandbox host, which is the intended failure mode.
# ---------------------------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ---------------------------------------------------------------------------
# Phase 4 — shared secret for HMAC-SHA256 receipt signing.
# The SAME value must be set as WEBHOOK_SECRET in the PFW Next.js app.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=
WEBHOOK_URL=http://localhost:3000/api/webhooks/trades

# Phase 4 — structured AI-strategy telemetry (scenario evaluations, not
# trade receipts). Same HMAC secret as WEBHOOK_SECRET above, separate
# endpoint/table on the PFW side (ScenarioMetrics).
METRICS_WEBHOOK_URL=http://localhost:3000/api/webhooks/metrics

# ---------------------------------------------------------------------------
# Simulated USD -> ILS rate used to derive the agorot figures PFW stores.
# Matches Trade.exchangeRateAtEntry (Decimal(12,6), ILS per 1 USD).
# ---------------------------------------------------------------------------
USD_ILS_RATE=3.700000

# ---------------------------------------------------------------------------
# Autonomous mode — when true, main.py's lifespan starts scheduler.py's
# trading_loop() as a background task at boot: an infinite loop that picks
# a random inference.MARKET_SCENARIOS entry, runs it through the same
# Tier-0 pipeline /signals/execute uses, and waits a random 60-300s
# between cycles. Off by default (unset, empty, or any non-truthy value);
# leave off unless you want the agent submitting paper trades on its own
# with no per-request trigger.
# ---------------------------------------------------------------------------
AUTONOMOUS_MODE=

# ---------------------------------------------------------------------------
# Long-term core (docs/core-paper-mode.md, docs/core-runbook.md).
# A SECOND Alpaca paper account, separate from the news agent's: sharing one
# would let the news router's exits dismantle a portfolio meant to be held for
# years. Names only here; the real values go in .env (git-ignored) or the
# host's secret store, never in git or in a chat.
# ---------------------------------------------------------------------------
CORE_ALPACA_KEY_ID=
CORE_ALPACA_SECRET_KEY=
# The Allocator signs its proposals with this (32+ random characters). It must
# DIFFER from WEBHOOK_SECRET above, which signs the owner's approvals and halts:
# otherwise a compromised Allocator could approve its own plans.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CORE_PLAN_SECRET=
# Where the Allocator and the owner's console (risk_router.core_ctl) reach the
# core router.
CORE_ROUTER_URL=http://127.0.0.1:8080
# Optional but strongly advised: a webhook that is told when a plan is waiting
# for your approval, or something went wrong. Slack/Discord incoming webhooks
# take the default "json" format; for ntfy.sh use a hard-to-guess topic URL and
# CORE_ALERT_FORMAT=ntfy.
CORE_ALERT_WEBHOOK_URL=
CORE_ALERT_FORMAT=json
# Optional: mirror the core to the PFW website, so you can watch it there
# (docs/core-runbook.md, "Watching it on the website"). Read-only: PFW can show
# the core, never steer it. The full URL of PFW's /api/webhooks/core, e.g.
#   https://your-pfw-domain/api/webhooks/core        (http:// only for localhost)
# Signed with WEBHOOK_SECRET above, the secret the trade receipts already use.
# Leave empty to keep the core off the website; nothing else changes.
CORE_PFW_SYNC_URL=
# Optional overrides (the defaults are right for a normal checkout):
#   CORE_STATE_DIR=core-state          where the journal and plan state live (a volume, in a container)
#   CORE_POLICY_PATH=policy/core.toml
